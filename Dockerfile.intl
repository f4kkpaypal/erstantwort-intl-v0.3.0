# Always-on intl pilot image. Not for Render Free.
# Boots engine/intlServer.js so REAL_DATA_ALLOWED / CHANNEL_MODE=live work.
FROM node:22.23-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:22.23-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PRODUCT_MODE=intl \
    EPHEMERAL_DISK=false \
    INTL_WHATSAPP_UI=false \
    MULTI_USER=true \
    AUTO_SET_WEBHOOK=true \
    LOG_STDOUT=true \
    NODE_OPTIONS=--max-old-space-size=384
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY core ./core
COPY engine ./engine
COPY ui-intl ./ui-intl
COPY fixtures/intl ./fixtures/intl
COPY assets ./assets
COPY db ./db
COPY scripts/telegram_webhook.js ./scripts/telegram_webhook.js
COPY scripts/backup_intl.js ./scripts/backup_intl.js
COPY scripts/pg_migrate_smoke.js ./scripts/pg_migrate_smoke.js
COPY scripts/team_smoke.js ./scripts/team_smoke.js
COPY scripts/preflight_server.js ./scripts/preflight_server.js
RUN mkdir -p /data \
  && chown -R node:node /app /data
USER node
EXPOSE 8791
HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||process.env.INTL_PORT||8791)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "engine/intlServer.js"]
