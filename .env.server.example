# Erstantwort intl — шаблон .env для always-on сервера (Дубай, multi-broker).
# На сервере: cp .env.server.example .env && nano .env
# Секреты сгенерировать: openssl rand -hex 32
# Затем: docker compose -f docker-compose.intl.yml up -d --build

PRODUCT_MODE=intl
CHANNEL_MODE=sim
HOST=0.0.0.0
INTL_PORT=8791

# После приёмки day-0 поставьте live + оба флага real-data:
# CHANNEL_MODE=live
# REAL_DATA_ALLOWED=true
# ALLOW_REAL_DATA=true
REAL_DATA_ALLOWED=false
ALLOW_REAL_DATA=false

MULTI_USER=true
TELEGRAM_ALLOWED_USER_IDS=*
OWNER_TELEGRAM_ID=

HASH_SALT=change-me-hash-salt
ENGINE_TOKEN=change-me-engine-token
POSTGRES_USER=intl
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=intl

UI_PUBLIC_BASE=https://app.your-domain.ae
BROKER_TZ=Asia/Dubai
TRUST_PROXY=1
DIGEST_TIME=08:30
AED_PER_USD=3.6725

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
AUTO_SET_WEBHOOK=true

DEMO_UI_NO_AUTH=false
ALLOW_INSECURE_DEV=false
EPHEMERAL_DISK=false
INTL_WHATSAPP_UI=false
INTL_AI_OPTIONS=false
INTL_LIVE_AUTOSEND=false
LLM_MODE=mock
MAX_REPLIES_PER_HOUR=30
MAX_REPLIES_PER_CHAT_HOUR=20
LOG_STDOUT=true
PG_QUERY_TIMEOUT_MS=5000
