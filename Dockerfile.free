FROM node:22.23-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY core ./core
COPY engine ./engine
COPY ui-intl ./ui-intl
COPY fixtures/intl ./fixtures/intl
COPY assets ./assets
COPY db ./db
COPY scripts/free_host.js ./scripts/free_host.js
COPY scripts/telegram_webhook.js ./scripts/telegram_webhook.js
RUN mkdir -p /data && chown -R node:node /app /data
USER node
ENV NODE_ENV=production
EXPOSE 8791
CMD ["node", "scripts/free_host.js"]
